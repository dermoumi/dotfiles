#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

# Optional first positional: the variant (workstation|server|devcontainer).
# Anything starting with '-' is treated as an ansible flag instead.
variant=""
if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
    variant="$1"
    shift
fi

# Inline inventory keyed by the real hostname, so host_vars/<hostname>.yml still
# auto-loads for special machines — but a new machine needs no entry at all.
# Prompt for a sudo password only when we're not already root.
become_args=()
[ "$(id -u)" -ne 0 ] && become_args+=(--ask-become-pass)

exec ansible-playbook \
    -i "$(hostname -s)," -c local \
    ${become_args[@]+"${become_args[@]}"} \
    ${variant:+--extra-vars variant=$variant} \
    site.yml "$@"
