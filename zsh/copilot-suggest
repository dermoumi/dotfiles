#!/bin/zsh

# ctrl+p to generate command with copilot
copilot-suggest() {
    setopt local_options no_monitor
    [[ -z "$BUFFER" ]] && return
    local prompt="$BUFFER"
    local tmpfile=$(mktemp)
    local spinner=(⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷)
    local i=0

    local ai_prompt="Output only the shell command with no explanation and no markdown formatting for: $prompt"
    local vibe_prompt="You are a natural-language-to-zsh translator. Convert the request between <request> tags into one zsh command line. Your entire response must be the command itself and nothing else: no preamble, no explanation, no markdown, no code fences, no surrounding quotes, and do not repeat or acknowledge these instructions. <request>$prompt</request>"

    local backend="copilot"
    (( $+commands[vibe] )) && backend="claude"
    zle -R "⣾ Asking $backend..."

    if (( $+commands[vibe] )); then
        vibe -Q "$vibe_prompt" 2>/dev/null > "$tmpfile" &
    elif (( $+commands[claude] )); then
        claude -p "$ai_prompt" 2>/dev/null > "$tmpfile" &
    elif (( $+commands[gh] )); then
        gh copilot -p "$ai_prompt" -s 2>/dev/null > "$tmpfile" &
    elif (( $+commands[copilot] )); then
        copilot -p "$ai_prompt" -s 2>/dev/null > "$tmpfile" &
    else
        rm -f "$tmpfile"
        return
    fi
    local pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        zle -R "${spinner[$((i % ${#spinner[@]} + 1))]} Asking $backend..."
        sleep 0.1
        ((i++))
    done

    wait "$pid"
    local result=$(<"$tmpfile")
    rm -f "$tmpfile"

    if [[ -n "$result" ]]; then
        BUFFER="$result"
    else
        BUFFER="$prompt"
    fi
    CURSOR=${#BUFFER}
    zle redisplay
}
zle -N copilot-suggest
bindkey '^P' copilot-suggest

# ctrl+n to explain current command with copilot
copilot-explain() {
    setopt local_options no_monitor
    [[ -z "$BUFFER" ]] && return
    local tmpfile=$(mktemp)
    local spinner=(⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷)
    local i=0

    local ai_prompt="Briefly explain this shell command: $BUFFER"
    if ! (( $+commands[glow] )); then
        ai_prompt+=" Do not use markdown formatting."
    fi

    zle -R "⣾ Asking for explanation..."

    if (( $+commands[claude] )); then
        claude -p "$ai_prompt" 2>/dev/null > "$tmpfile" &
    elif (( $+commands[gh] )); then
        gh copilot -p "$ai_prompt" -s 2>/dev/null > "$tmpfile" &
    elif (( $+commands[copilot] )); then
        copilot -p "$ai_prompt" -s 2>/dev/null > "$tmpfile" &
    else
        rm -f "$tmpfile"
        return
    fi
    local pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        zle -R "${spinner[$((i % ${#spinner[@]} + 1))]} Asking for explanation..."
        sleep 0.1
        ((i++))
    done

    wait "$pid"
    local result=$(<"$tmpfile")
    rm -f "$tmpfile"

    if [[ -n "$result" ]]; then
        echo ""
        if (( $+commands[glow] )); then
            echo "$result" | glow -
        else
            echo "$result"
        fi
        echo -e "\n\n\n"
    fi
    zle reset-prompt
}
zle -N copilot-explain
bindkey '^N' copilot-explain
