#!/bin/zsh

effidev() {
    # Open vibe on a project under $EFFIDEV_ROOT (default ~/work/efficity).
    # A second argument runs that project as a git worktree branch.
    local root="${EFFIDEV_ROOT:-$HOME/work/efficity}"
    local project="$1"
    local branch="$2"

    if [[ -z "$project" ]]; then
        print -u2 "usage: effidev <project> [branch]"
        return 1
    fi

    local dir="$root/$project"
    if [[ ! -d "$dir" ]]; then
        print -u2 "effidev: no such project: $project (in $root)"
        return 1
    fi

    if [[ -n "$branch" ]]; then
        (cd "$dir" && vibe "w:$branch")
    else
        (cd "$dir" && vibe)
    fi
}
