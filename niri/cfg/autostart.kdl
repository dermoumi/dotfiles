// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &" // Polkit
spawn-at-startup "noctalia"

// A declarative [[plugins.source]] in config.toml didn't register on noctalia
// 5.4.1, so add the dotfiles-vendored plugin source once the daemon is up.
spawn-sh-at-startup "for i in $(seq 30); do noctalia msg plugins source add dotfiles path $HOME/.dotfiles/noctalia/local-plugins >/dev/null 2>&1 && break; sleep 1; done"
