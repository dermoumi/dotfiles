// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
  keyboard {
    numlock // Enable numlock on startup

    repeat-delay 250
    repeat-rate 60

    xkb {
      //If you want to overwrite your keyboard layout,
      // uncomment the line below and change the layout accordingly.
      //layout "us" // Use the American keyboard layout
      layout "us"
      variant "altgr-intl"
      options "compose:caps"
    }
  }

  mouse {
    // scroll-factor 0.9
  }

  touchpad {
    tap // Enable tap-to-click
    natural-scroll // Enable natural (macOS-style) scrolling
  }

  // Follow-focus under pointer, but ignore off-view edge slivers (which need a
  // large view scroll to activate). Cap is fraction of screen width scrolled.
  focus-follows-mouse max-scroll-amount="30%"
}

window-rule {
  match app-id="com.mitchellh.ghostty"

  scroll-factor 0.08
}

gestures {
  dnd-edge-view-scroll {
    // Increase the trigger area and maximum speed.
    trigger-width 100
    max-speed 5000
  }

  hot-corners {
    off
  }
}
